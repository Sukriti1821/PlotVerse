# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/plot-booking-app

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Storage (Required for Production Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway
# IMPORTANT: Use rzp_test_* for development and demo mode to prevent live card charges.
# Live keys start with rzp_live_*.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email & SMTP Notifications (Booking Confirmations, Rejections, Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Thikana" <noreply@thikana.com>

# Database Seeding Security (Guards remote MongoDB Atlas & production instances)
# Seeding on a remote or production DB is BLOCKED unless SEED_CONFIRM=true
SEED_CONFIRM=false
SEED_ADMIN_PASSWORD=your_secure_admin_password_here
SEED_TEST_PASSWORD=your_test_accounts_password_here
