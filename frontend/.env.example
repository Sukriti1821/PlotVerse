# Thikana Frontend Environment Variables Example
# In production on Vercel: Set VITE_API_URL to your deployed Render backend (e.g. https://thikana-backend.onrender.com/api)

# Primary Backend API URL (REQUIRED in production on Vercel)
VITE_API_URL=http://localhost:5000/api

# Legacy fallback alias for API base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Razorpay Public Key ID (Frontend ONLY uses public Key ID, never the secret)
# Use rzp_test_* for development/staging demo. Real charges only occur with rzp_live_*.
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
