# Base API URL for Backend (e.g. https://your-backend.onrender.com/api in production)
VITE_API_BASE_URL=http://localhost:5000/api

# Razorpay Public Key ID (Frontend ONLY uses public Key ID, never the secret)
# Use rzp_test_* for development/staging demo. Real charges only occur with rzp_live_*.
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
